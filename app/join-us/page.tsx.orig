"use client"

import * as React from "react"
import { zodResolver } from "@hookform/resolvers/zod"
import { useForm } from "react-hook-form"
import { toast } from "sonner"
import * as z from "zod"

import { Button } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Input } from "@/components/ui/input"
import { Textarea } from "@/components/ui/textarea"
import {
  Form,
  FormControl,
  FormDescription,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form"
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select"

// 1. Define base common fields (PIC User Data)
const baseSchema = z.object({
  picName: z.string().min(3, "PIC Name must be at least 3 characters."),
  email: z.string().email("Invalid email address format."),
  phone: z.string().min(10, "Phone number must be at least 10 digits."),
  password: z.string().min(8, "Password must be at least 8 characters."),
})

// 2. Define entity-specific schemas
const perusahaanSchema = z.object({
  accountType: z.literal("perusahaan"),
  companyName: z.string().min(3, "Company name is required."),
  nib: z.string().length(13, "NIB (Nomor Induk Berusaha) must be exactly 13 digits."),
  address: z.string().min(10, "Full company address is required."),
})

const peternakSchema = z.object({
  accountType: z.literal("peternak"),
  farmName: z.string().min(3, "Farm name is required."),
  livestockType: z.string().min(3, "Please specify the main livestock type."),
  capacity: z.union([z.number(), z.string().transform(v => parseInt(v, 10))]).pipe(z.number().min(1)),
})

// 3. Create Discriminated Union based on accountType
const formSchema = z.discriminatedUnion("accountType", [
  baseSchema.merge(perusahaanSchema),
  baseSchema.merge(peternakSchema),
])

type FormValues = z.infer<typeof formSchema>

export default function RegistrationForm() {
  const form = useForm<FormValues>({
    resolver: zodResolver(formSchema),
    defaultValues: {
      accountType: "perusahaan",
      picName: "",
      email: "",
      phone: "",
      password: "",
      companyName: "",
      nib: "",
      address: "",
    } as FormValues, // Type assertion needed for default generic bypass
  })

  // Watch accountType to conditionally render fields
  const currentAccountType = form.watch("accountType")

  function onSubmit(data: FormValues) {
    // In production, split payload to insert User (PIC) and Tenant (Company/Farm) separately
    toast("Registration Payload Generated:", {
      description: (
        <pre className="mt-2 w-[320px] overflow-x-auto rounded-md bg-slate-950 p-4 text-slate-50">
          <code>{JSON.stringify(data, null, 2)}</code>
        </pre>
      ),
      position: "bottom-right",
    })
  }

  return (
    <div className="flex items-center justify-center p-4">
      <Card className="w-full max-w-2xl">
        <CardHeader>
          <CardTitle>TernakAja Registration</CardTitle>
          <CardDescription>
            Register your company or farm, and assign a primary Person in Charge (PIC).
          </CardDescription>
        </CardHeader>
        <CardContent>
          <Form {...form}>
            <form id="registration-form" onSubmit={form.handleSubmit(onSubmit as any)} className="space-y-6">
              
              {/* Account Type Selector */}
              <FormField
                control={form.control}
                name="accountType"
                render={({ field }) => (
                  <FormItem>
                    <FormLabel>Registration Type</FormLabel>
                    <Select onValueChange={field.onChange} defaultValue={field.value}>
                      <FormControl>
                        <SelectTrigger>
                          <SelectValue placeholder="Select account type" />
                        </SelectTrigger>
                      </FormControl>
                      <SelectContent>
                        <SelectItem value="perusahaan">Perusahaan (Company)</SelectItem>
                        <SelectItem value="peternak">Peternak (Independent Farm)</SelectItem>
                      </SelectContent>
                    </Select>
                    <FormMessage />
                  </FormItem>
                )}
              />

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {/* --- COMMON PIC DATA --- */}
                <div className="space-y-4">
                  <h3 className="text-sm font-semibold text-muted-foreground border-b pb-2">User (PIC) Details</h3>
                  
                  <FormField
                    control={form.control}
                    name="picName"
                    render={({ field }) => (
                      <FormItem>
                        <FormLabel>Full Name</FormLabel>
                        <FormControl>
                          <Input placeholder="John Doe" {...field} />
                        </FormControl>
                        <FormMessage />
                      </FormItem>
                    )}
                  />

                  <FormField
                    control={form.control}
                    name="email"
                    render={({ field }) => (
                      <FormItem>
                        <FormLabel>Work Email</FormLabel>
                        <FormControl>
                          <Input type="email" placeholder="john@example.com" {...field} />
                        </FormControl>
                        <FormMessage />
                      </FormItem>
                    )}
                  />

                  <FormField
                    control={form.control}
                    name="phone"
                    render={({ field }) => (
                      <FormItem>
                        <FormLabel>Phone Number</FormLabel>
                        <FormControl>
                          <Input type="tel" placeholder="+62..." {...field} />
                        </FormControl>
                        <FormMessage />
                      </FormItem>
                    )}
                  />

                  <FormField
                    control={form.control}
                    name="password"
                    render={({ field }) => (
                      <FormItem>
                        <FormLabel>Password</FormLabel>
                        <FormControl>
                          <Input type="password" {...field} />
                        </FormControl>
                        <FormMessage />
                      </FormItem>
                    )}
                  />
                </div>

                {/* --- CONDITIONAL ENTITY DATA --- */}
                <div className="space-y-4">
                  <h3 className="text-sm font-semibold text-muted-foreground border-b pb-2">
                    {currentAccountType === "perusahaan" ? "Company Details" : "Farm Details"}
                  </h3>

                  {currentAccountType === "perusahaan" && (
                    <>
                      <FormField
                        control={form.control}
                        name="companyName"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel>Company Name</FormLabel>
                            <FormControl>
                              <Input placeholder="PT Ternak Sukses" {...field} />
                            </FormControl>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                      <FormField
                        control={form.control}
                        name="nib"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel>NIB</FormLabel>
                            <FormControl>
                              <Input placeholder="13 Digit NIB" maxLength={13} {...field} />
                            </FormControl>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                      <FormField
                        control={form.control}
                        name="address"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel>Company Address</FormLabel>
                            <FormControl>
                              <Textarea placeholder="Full address" className="resize-none" {...field} />
                            </FormControl>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                    </>
                  )}

                  {currentAccountType === "peternak" && (
                    <>
                      <FormField
                        control={form.control}
                        name="farmName"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel>Farm Name</FormLabel>
                            <FormControl>
                              <Input placeholder="Peternakan Pak Budi" {...field} />
                            </FormControl>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                      <FormField
                        control={form.control}
                        name="livestockType"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel>Primary Livestock</FormLabel>
                            <FormControl>
                              <Input placeholder="Sapi Potong, Ayam Broiler, etc." {...field} />
                            </FormControl>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                      <FormField
                        control={form.control}
                        name="capacity"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel>Head Capacity</FormLabel>
                            <FormControl>
                              <Input type="number" placeholder="500" {...field} />
                            </FormControl>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                    </>
                  )}
                </div>
              </div>
            </form>
          </Form>
        </CardContent>
        <CardFooter>
          <div className="flex w-full items-center gap-2 justify-end border-t pt-4">
            <Button type="button" variant="outline" onClick={() => form.reset()}>
              Reset
            </Button>
            <Button type="submit" form="registration-form">
              Register Entity
            </Button>
          </div>
        </CardFooter>
      </Card>
    </div>
  )
}